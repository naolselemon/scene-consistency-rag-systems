{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/YOUR_ORG/scene-consistency-rag-systems/schemas/relationship-v1.0.json",
  "version": "1.0.0",
  "title": "Entity Relationship Schema",
  "description": "Defines relationships between characters and locations for RAG retrieval",
  "type": "object",
  "required": [
    "relationship_id",
    "source_entity", 
    "target_entity",
    "relationship_type"
  ],
  "properties": {
    "relationship_id": {
      "type": "string",
      "pattern": "^rel_[a-z_]+_\\d{3}$",
      "description": "Unique identifier for the relationship",
      "examples": ["rel_isaac_office_001", "rel_gertie_isaac_001"]
    },
    "source_entity": {
      "type": "string",
      "description": "ID of the source entity (character or location)",
      "pattern": "^(char|loc)_[a-z_]+_\\d{3}$",
      "examples": ["char_isaac_001", "loc_office_001"]
    },
    "target_entity": {
      "type": "string", 
      "description": "ID of the target entity (character or location)",
      "pattern": "^(char|loc)_[a-z_]+_\\d{3}$",
      "examples": ["loc_office_001", "char_gertie_001"]
    },
    "relationship_type": {
      "type": "string",
      "enum": ["appears_in", "associated_with", "interacts_with", "shares_theme"],
      "description": "Type of the relationship",
      "examples": ["appears_in", "interacts_with"]
    },
    "strength": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence or frequency of relationship",
      "examples": [0.85, 0.65, 0.95]
    },
    "tags": {
      "type": "array",
      "description": "Optional descriptive tags linking entities",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$",
        "$comment": "Lowercase with underscores, no spaces or special characters"
      },
      "uniqueItems": true,
      "examples": [["primary_setting", "work_context", "daytime"]]
    },
    "metadata": {
      "$ref": "metadata_schema.json",
      "description": "Shared metadata structure"
    }
  },
  "additionalProperties": false
}
