{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/YOUR_ORG/scene-consistency-rag-systems/schemas/metadata-v1.0.json",
  "version": "1.0.0",
  "title": "Metadata Schema",
  "description": "Shared metadata structure for all entities in the RAG system",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "description": "Original source file or data origin",
      "examples": ["isaac.txt", "manual_entry", "script_analysis", "llm_extraction"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Entity creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema definition version",
      "examples": ["1.0", "1.1"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Data quality confidence score",
      "examples": [0.95, 0.87, 1.0]
    },
    "validation_status": {
      "type": "string",
      "enum": ["validated", "draft", "auto_generated"],
      "description": "Schema validation status",
      "examples": ["validated", "auto_generated"]
    }
  },
  "additionalProperties": false
}
